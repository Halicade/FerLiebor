<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ArtableBedBase">
    <defName>FL_LeatherCrib</defName>
    <label>small layered hides</label>
    <description>A dense little pile of layered hides and leather, padded with soft fur. An acceptable sleeping spot for a baby.</description>
    <graphicData>
      <texPath>Things/Furniture/FL_LeatherCrib/FL_LeatherCrib</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <rect>(0,0.05,2,1.95)</rect>
      </damageData>
    </graphicData>

    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Mass>2.5</Mass>
      <Beauty>-1</Beauty>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <Comfort>0.45</Comfort>
      <ImmunityGainSpeedFactor>1</ImmunityGainSpeedFactor>
      <SurgerySuccessChanceFactor>0.9</SurgerySuccessChanceFactor>
      <BirthRitualQualityOffset MayRequire="Ludeon.RimWorld.Biotech">2</BirthRitualQualityOffset>
    </statBases>

    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <size>(1,1)</size>
    <stuffCategories>
      <li>Leathery</li>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>

    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_healPerDay>4</bed_healPerDay>
      <bed_maxBodySize>0.25</bed_maxBodySize>
      <bed_crib>True</bed_crib>
    </building>
    <fillPercent>0.4</fillPercent>
    <techLevel>Neolithic</techLevel>

    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
        </linkableFacilities>
      </li>
    </comps>
  </ThingDef>

</Defs>