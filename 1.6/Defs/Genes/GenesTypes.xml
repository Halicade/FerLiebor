<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<GeneDef ParentName="GeneEarsBase">
		<defName>Fer_Liebor_Ear</defName>
		<label>Lagomorphic Ears</label>
		<description>Carriers of this gene have long, fluffy ears reminiscent of Terran rabbits.</description>
		<iconPath>UI/BunEar</iconPath>
		<exclusionTags>
			<li>Ears</li>
		</exclusionTags>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>9000</displayOrderInCategory>
   <statOffsets>
			<HuntingStealth>0.30</HuntingStealth>
      <TrapSpringChance>-0.3</TrapSpringChance>
		</statOffsets>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPaths>
					<li>Things/Pawn/Parts/FreBunEar1</li>
					<li>Things/Pawn/Parts/FreBunEar2</li>
					<li>Things/Pawn/Parts/FreBunEar3</li>
					<li>Things/Pawn/Parts/FreBunEar4</li>
					<li>Things/Pawn/Parts/FreBunEar5</li>
				</texPaths>
				<narrowCrownHorizontalOffset>0.03</narrowCrownHorizontalOffset>
				<colorType>Hair</colorType>
				<parentTagDef>Head</parentTagDef>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<defaultData>
						<layer>70</layer>
					</defaultData>
				</drawData>
			</li>
		</renderNodeProperties>
		<capMods>
			<li>
				<capacity>Hearing</capacity>
				<postFactor>1.05</postFactor>
			</li>
		</capMods>
		<symbolPack>
			<prefixSymbols>
        <li><symbol>bun</symbol></li>
        <li><symbol>rabbit</symbol></li>
			</prefixSymbols>
			<suffixSymbols>
        <li><symbol>ear</symbol></li>
        <li><symbol>thumper</symbol></li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>
	
	<GeneDef ParentName="GeneTailBase">
		<defName>Fer_Liebor_Tail</defName>
		<label>Tufted Tail</label>
		<description>Carriers of this gene grow a huge, fluffy tail, starting at the middle of their spine and forcing their natural stance to lean forwards slightly to balance out its weight.</description>
		<iconPath>UI/BunTail</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>9000</displayOrderInCategory>
		<statOffsets>
			<ComfyTemperatureMin>-10</ComfyTemperatureMin>
		</statOffsets>
		<renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Parts/FreBunTail</texPath>
				<narrowCrownHorizontalOffset>0.03</narrowCrownHorizontalOffset>
				<colorType>Hair</colorType>
				<parentTagDef>Body</parentTagDef>
				<useRottenColor>true</useRottenColor>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<drawData>
					<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
					<defaultData>
						<layer>-2</layer>
					</defaultData>
					<dataNorth>
						<offset>(-0.25, 0, -0.35)</offset>
						<layer>90</layer>
					</dataNorth>
					<dataSouth>
						<offset>(0.25, 0, 0.15)</offset>
					</dataSouth>
					<dataEast>
						<offset>(-1, -0.5, -0.25)</offset>
					</dataEast>
					<dataWest>
						<offset>(1, -0.5, -0.25)</offset>
					</dataWest>
				</drawData>
			</li>
		</renderNodeProperties>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-1</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_NaturalWeapons</defName>
		<label>natural weapons</label>
		<labelShortAdj>sharpened</labelShortAdj>
		<description>Carriers of this gene grow vicious, sharpened claws on their digits and serrated fangs on their maws, giving their unarmed strikes sharp cutting and biting damage. These natural weapons are unwieldy for fine motor skills, worsening their manipulation.</description>
		<iconPath>UI/BunClaws</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>30</displayOrderInCategory>
		<customEffectDescriptions>
			<li>Unarmed strikes deal slashing and piercing damage.</li>
		</customEffectDescriptions>
		<capMods>
			<li>
				<capacity>Manipulation</capacity>
				<postFactor>0.90</postFactor>
			</li>
		</capMods>
		<modExtensions>
			<li Class="VEF.Genes.GeneExtension">
				<hediffsToBodyParts>
					<li>
						<hediff>FL_Claws</hediff>
						<bodyparts>
							<li>Hand</li>
							<li>Hand</li>
						</bodyparts>
					</li>
					<li>
						<hediff>FL_Fangs</hediff>
						<bodyparts>
							<li>Jaw</li>
						</bodyparts>
					</li>
				</hediffsToBodyParts>
			</li>
		</modExtensions>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-2</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Fur</defName>
		<label>caveling body</label>
		<description>Carriers of this gene have a hunched-over, digitigrade body, covered in thick, coarse fur.</description>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-2</biostatMet>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>410</displayOrderInCategory>
		<statOffsets>
			<ComfyTemperatureMin>-15</ComfyTemperatureMin>
		</statOffsets>
		<iconPath>UI/BunFur</iconPath>
		<statFactors>
			<MoveSpeed>1.5</MoveSpeed>
			<Mass>0.75</Mass>
			<MeatAmount>0.75</MeatAmount>
			<LeatherAmount>0.75</LeatherAmount>
			<VEF_CosmeticBodySize_Multiplier>0.75</VEF_CosmeticBodySize_Multiplier>
			<MiningSpeed>1.3</MiningSpeed>
			<SmoothingSpeed>1.3</SmoothingSpeed>
		</statFactors>
		<exclusionTags>
			<li>Fur</li>
		</exclusionTags>
		<fur>Fer_Liebor_Fur</fur>
		<skinIsHairColor>true</skinIsHairColor>
		<tattoosVisible>false</tattoosVisible>
		<renderNodeProperties>
			<li>
				<debugLabel>Fur</debugLabel>
				<nodeClass>PawnRenderNode_Fur</nodeClass>
				<workerClass>PawnRenderNodeWorker_Fur</workerClass>
				<baseLayer>5</baseLayer>
				<rotDrawMode>Fresh, Rotting</rotDrawMode>
				<colorType>Hair</colorType>
				<parentTagDef>Body</parentTagDef>
			</li>
		</renderNodeProperties>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Head</defName>
		<label>fer'liebor head</label>
		<labelShortAdj>rabbit-snouted</labelShortAdj>
		<description>Carriers of this gene have an odd, teardrop-shaped head with a diminutive lapine snout.</description>
		<biostatCpx>0</biostatCpx>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>410</displayOrderInCategory>
		<iconPath>UI/BunHead</iconPath>
		<exclusionTags>
			<li>Head</li>
			<li>HeadType</li>
		</exclusionTags>
		<forcedHeadTypes>
			<li>FreBunHead1Normal</li>
			<li>FreBunHead1Pretty</li>
			<li>FreBunHead1Stern</li>
			<li>FreBunHead1Wide</li>
			<li>FreBunHead2Normal</li>
			<li>FreBunHead2Pretty</li>
			<li>FreBunHead2Stern</li>
			<li>FreBunHead2Wide</li>
			<li>FreBunHead3Normal</li>
			<li>FreBunHead3Pretty</li>
			<li>FreBunHead3Stern</li>
			<li>FreBunHead3Wide</li>
		</forcedHeadTypes>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Eyes</defName>
		<label>fer'liebor eyes</label>
		<labelShortAdj>pale-eyed</labelShortAdj>
		<description>Carriers of this gene have wide, pale, colourless eyes, adapted for survival in low-light, cramped environments. This makes them extremely nearsighted.</description>
		<biostatCpx>1</biostatCpx>
		<biostatMet>2</biostatMet>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>410</displayOrderInCategory>
		<iconPath>UI/BunEyes</iconPath>
		<statFactors>
			<ShootingAccuracyFactor_Long>0.15</ShootingAccuracyFactor_Long>
			<ShootingAccuracyFactor_Medium>0.35</ShootingAccuracyFactor_Medium>
			<ShootingAccuracyFactor_Short>0.75</ShootingAccuracyFactor_Short>
		</statFactors>
	</GeneDef>
	
	<GeneDef ParentName="GeneHairStyleBase">
		<defName>Fer_Liebor_Hair</defName>
		<label>thin-haired</label>
		<description>Carriers of this gene have thin, loose, stringy hair that often hides their face somewhat.</description>
		<iconPath>UI/BunHair</iconPath>
		<displayOrderInCategory>57</displayOrderInCategory>
		<hairTagFilter>
			<whitelist>true</whitelist>
			<tags>
				<li>Fer'Liebor</li>
			</tags>
		</hairTagFilter>
	</GeneDef>
	
