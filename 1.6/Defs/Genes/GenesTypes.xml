	<GeneDef ParentName="GeneHairColorBase">
		<defName>Hair_PaleGrayish</defName>
		<label>caveling white hair</label>
		<description>Carriers of this gene exhibit a natural lack of pigmentation to their hair, leading it to take on a very pale off-gray colour.</description>
		<hairColorOverride>(239, 227, 239)</hairColorOverride>
		<selectionWeight>0.05</selectionWeight>
		<displayOrderInCategory>130</displayOrderInCategory>
		<randomBrightnessFactor>0</randomBrightnessFactor>
	</GeneDef>
	
	<GeneDef ParentName="GeneHairColorBase">
		<defName>Hair_PaleBrownish</defName>
		<label>caveling dusty hair</label>
		<description>Carriers of this gene exhibit a natural lack of pigmentation to their hair, leading it to take on a very pale dusty-brown colour.</description>
		<hairColorOverride>(206, 187, 200)</hairColorOverride>
		<selectionWeight>0.05</selectionWeight>
		<displayOrderInCategory>130</displayOrderInCategory>
		<randomBrightnessFactor>0</randomBrightnessFactor>
	</GeneDef>
	
	<GeneDef ParentName="GeneHairColorBase">
		<defName>Hair_PaleBlueish</defName>
		<label>caveling gray hair</label>
		<description>Carriers of this gene exhibit a natural lack of pigmentation to their hair, leading it to take on a very pale blue-gray colour.</description>
		<hairColorOverride>(207, 206, 224)</hairColorOverride>
		<selectionWeight>0.05</selectionWeight>
		<displayOrderInCategory>130</displayOrderInCategory>
		<randomBrightnessFactor>0</randomBrightnessFactor>
	</GeneDef>
	
	<GeneDef ParentName="GeneHairColorBase">
		<defName>Hair_PaleBlondeish</defName>
		<label>caveling cream hair</label>
		<description>Carriers of this gene exhibit a natural lack of pigmentation to their hair, leading it to take on a very pale blonde colour.</description>
		<hairColorOverride>(233, 213, 216)</hairColorOverride>
		<selectionWeight>0.05</selectionWeight>
		<displayOrderInCategory>130</displayOrderInCategory>
		<randomBrightnessFactor>0</randomBrightnessFactor>
	</GeneDef>
	
	<GeneDef ParentName="GeneHairColorBase">
		<defName>Hair_PaleRedish</defName>
		<label>caveling dusky hair</label>
		<description>Carriers of this gene exhibit a natural lack of pigmentation to their hair, leading it to take on a very pale dusky ginger colour.</description>
		<hairColorOverride>(223, 193, 204)</hairColorOverride>
		<selectionWeight>0.05</selectionWeight>
		<displayOrderInCategory>130</displayOrderInCategory>
		<randomBrightnessFactor>0</randomBrightnessFactor>
	</GeneDef>
	
	
	<GeneDef>
		<defName>Fer_Liebor_Mayflies</defName>
		<label>Short Lifespan</label>
		<labelShortAdj>short-lived</labelShortAdj>
		<description>Carriers of this gene seem to reach old age and die of natural causes at a much earlier age than baseliners.</description>
		<iconPath>UI/BunMayflies</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>30</displayOrderInCategory>
		<marketValueFactor>-5.5</marketValueFactor>
		<statFactors>
			<LifespanFactor>0.4</LifespanFactor>
			<CancerRate>1.5</CancerRate>
		</statFactors>
		<biostatCpx>0</biostatCpx>
		<biostatMet>2</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_GrowsQuickly</defName>
		<label>Grows Quickly</label>
		<description>Carriers of this gene will age at a much faster rate than baseliners. They age faster the younger they are.</description>
		<iconPath>UI/BunAge</iconPath>
		<exclusionTags>
			<li>AG_Aging</li>
			<li>Aging</li>
			<li>Age</li>
		</exclusionTags>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>52</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-1</biostatMet>
		<statFactors>
			<LearningRateFactor>1.5</LearningRateFactor>
		</statFactors>
		<biologicalAgeTickFactorFromAgeCurve>
			<points>
				<li>(0, 7.0)</li>
				<li>(7, 5.0)</li>
				<li>(13, 4.0)</li>
				<li>(18, 2)</li>
			</points>
		</biologicalAgeTickFactorFromAgeCurve>
		<selectionWeight>0</selectionWeight>
	</GeneDef>
	
	
	<GeneDef>
		<defName>Fer_Liebor_Nimble</defName>
		<label>Nimble</label>
		<description>Carriers of this gene have inhumanly lithe, flexible bodies and sharp reflexes, making landing a direct hit on them difficult in close quarters.</description>
		<iconPath>UI/BunDodger</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>100</displayOrderInCategory>
		<statOffsets>
			<MeleeDodgeChance>4</MeleeDodgeChance>
		</statOffsets>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-2</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Savage</defName>
		<label>Savage</label>
		<description>Carriers of this gene are uncivilized and brutish, and will never mind living in the most animalistic conditions. This makes them extremely unpleasant in the eyes of most civilized beings.</description>
		<iconPath>UI/BunSavage</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>100</displayOrderInCategory>
		<marketValueFactor>-1.5</marketValueFactor>
		<disablesNeeds>
			<li>Beauty</li>
			<li>Comfort</li>
		</disablesNeeds>
		<biostatCpx>0</biostatCpx>
		<biostatMet>2</biostatMet>
	</GeneDef>
	
	
	<ThoughtDef>
		<defName>Fer_Liebor_Savage_Thought</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>FerLiebor.FL_Thoughts_Patch</workerClass>
		<validWhileDespawned>true</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
			<li>
				<label>savage</label>
				<description>Innate Savagery</description>
				<baseOpinionOffset>-50</baseOpinionOffset>
			</li>
		</stages>
		<modExtensions>
			<li Class="FerLiebor.FL_Extension">
				<hatedGenes>
					<li>Fer_Liebor_Savage</li>
				</hatedGenes>
				<nullifyingGenes>
					<li>Fer_Liebor_Savage</li>
				</nullifyingGenes>
			</li>
		</modExtensions>
	</ThoughtDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Pregnancy</defName>
		<label>Rapid Gestation</label>
		<description>Carriers of this gene will gestate offspring remarkably fast compared to most other xenotypes.</description>
		<iconPath>UI/BunPreg</iconPath>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<displayOrderInCategory>1</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-1</biostatMet>
		<modExtensions>
			<li Class="VEF.Genes.GeneExtension">
				<pregnancySpeedFactor>3</pregnancySpeedFactor>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Litters</defName>
		<label>Litter Births</label>
		<description>Carriers of this gene will gestate offspring in litters, typically of one to four kits.</description>
		<iconPath>UI/BunPreg</iconPath>
		<prerequisite>Fer_Liebor_Pregnancy</prerequisite>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<biostatMet>0</biostatMet>
		<biostatCpx>-1</biostatCpx>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_Bloodlust</defName>
		<label>Genetic Bloodlust</label>
		<labelShortAdj>violent</labelShortAdj>
		<description>Carriers of this gene are seemingly predisposed to enjoy violence and bloodshed.</description>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<forcedTraits>
			<li>
				<def>Bloodlust</def>
			</li>
		</forcedTraits>
		<iconPath>UI/BunViolence</iconPath>
		<prerequisite>Fer_Liebor_Savage</prerequisite>
		<displayOrderInCategory>1</displayOrderInCategory>
		<biostatCpx>0</biostatCpx>
		<biostatMet>1</biostatMet>
	</GeneDef>
	
	<GeneDef>
		<defName>Fer_Liebor_BadEating</defName>
		<label>Devourer</label>
		<labelShortAdj>devouring</labelShortAdj>
		<description>Carriers of this gene will eat anything they can get their hands onto, from human corpses to raw food.</description>
		<iconPath>UI/BunDevourer</iconPath>
		<displayOrderInCategory>1</displayOrderInCategory>
		<displayCategory>Fer_Liebor_Genes</displayCategory>
		<forcedTraits>
			<li>
				<def>Trait_Omnivorous_Devourer</def>
			</li>
		</forcedTraits>
		<dontMindRawFood>true</dontMindRawFood>
		<biostatCpx>0</biostatCpx>
		<biostatMet>-2</biostatMet>
	</GeneDef>

</Defs>
