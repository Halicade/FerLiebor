<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <FactionDef ParentName="TribeRoughBase">
        <defName>FeralWarren</defName>
        <label>feral caveling warren</label>
        <description>Fer'Liebor are, generally, not considered to be particularly good neighbors. Though most of the world considers them to be by and large wretched, cruel, savage vermin, their resilience and aptitude for clawing their way to survival in the most hostile of environments makes them formidable foes, and persistent problems.

            In spite of their near-animalistic technological level, you'd be remiss to underestimate them: their pack tactics, brutality, and the deadly sharpness of claw and tooth will make quick work of the unprepared, foolish, or overconfident. When the tide comes for you, your best hope is fire, or prayer.

            This particular warren is led only by those of the most cruel and vengeful sort. Unless you are of their own kind, they won't even consider entreating with you.</description>
        <factionIconPath>UI/BunFactionIcon</factionIconPath>
        <pawnSingular>caveling</pawnSingular>
        <pawnsPlural>cavelings</pawnsPlural>
        <autoFlee>false</autoFlee>
        <earliestRaidDays>30</earliestRaidDays>
        <hostileToFactionlessHumanlikes>True</hostileToFactionlessHumanlikes>
        <naturalEnemy>false</naturalEnemy>
        <permanentEnemy>false</permanentEnemy>
        <permanentEnemyToEveryoneExcept>
            <li>PlayerWarren</li>
            <li>CivilWarren</li>
            <li>FeralWarren</li>
        </permanentEnemyToEveryoneExcept>
        <xenotypeSet Inherit="False">
            <xenotypeChances>
                <Fer_Liebor>999</Fer_Liebor>
            </xenotypeChances>
        </xenotypeSet>
        <colorSpectrum Inherit="False">
            <li>(0.95, 0.75, 0.80)</li>
            <li>(0.80, 0.70, 0.80)</li>
            <li>(0.85, 0.70, 0.80)</li>
        </colorSpectrum>
        <requiredCountAtGameStart>0</requiredCountAtGameStart>
        <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
        <basicMemberKind>FL_Caveling</basicMemberKind>
        <backstoryFilters>
            <li>
                <categories>
                    <li>Tribal</li>
                </categories>
            </li>
        </backstoryFilters>
        <techLevel>Animal</techLevel>
        <factionNameMaker>NamerFactionFeralWarren</factionNameMaker>
        <settlementNameMaker>NamerSettlementFeralWarren</settlementNameMaker>
        <raidLootMaker>WarrenRaidLootMaker</raidLootMaker>
        <raidLootValueFromPointsCurve>
            <points>
                <li>(35,     15)</li>
                <li>(100,   120)</li>
                <li>(1000,  500)</li>
                <li>(2000,  800)</li>
                <li>(4000, 1000)</li>
            </points>
        </raidLootValueFromPointsCurve>
        <disallowedMemes IsNull="True" />
        <structureMemeWeights MayRequire="Ludeon.RimWorld.Ideology" Inherit="False">
            <Structure_TheistEmbodied>5</Structure_TheistEmbodied>
            <AM_Structure_Neolithic MayRequire="sarg.alphamemes">3</AM_Structure_Neolithic>
            <Structure_Animist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Animist>
        </structureMemeWeights>
        <allowedMemes MayRequire="Ludeon.RimWorld.Ideology" Inherit="False">
            <li>Tunneler</li>
            <li>FemaleSupremacy</li>
            <li>Raider</li>
            <li>Supremacist</li>
            <li>AnimalPersonhood</li>
            <li>Cannibal</li>
            <li MayRequire="sarg.alphamemes">AM_Structure_Neolithic</li>
            <li MayRequire="vanillaexpanded.vmemese">VFEA_Isolationist</li>
            <li MayRequire="vanillaexpanded.vmemese">VME_BloodCourt</li>
            <li MayRequire="sarg.alphamemes">AM_Sadist</li>
        </allowedMemes>
        <styles MayRequire="Ludeon.RimWorld.Ideology" Inherit="False">
            <li MayRequire="gm.cannibal.style">GM_CannibalStyle</li>
            <li>Morbid</li>
            <li>Totemic</li>
        </styles>
        <canStageAttacks>true</canStageAttacks>
        <apparelStuffFilter>
            <thingDefs>
                <li>Leather_Wolf</li>
                <li>Leather_Human</li>
                <li>Leather_Patch</li>
                <li>Leather_Pig</li>
            </thingDefs>
        </apparelStuffFilter>

        <pawnGroupMakers Inherit="False">
            <li>
                <kindDef>Combat</kindDef>
                <commonality>100</commonality>
                <options>
                    <Feral_Fledgling>5</Feral_Fledgling>
                    <Feral_Hunter>10</Feral_Hunter>
                    <Feral_Protector>5</Feral_Protector>
                    <Feral_Matriarch>1</Feral_Matriarch>
                    <Megaspider>0.75</Megaspider>
                </options>
            </li>
            <li>
                <!-- breach-capable fights, breachers plus ranged with melee mix-ins -->
                <kindDef>Combat</kindDef>
                <commonality>5</commonality>
                <options>
                    <Feral_Digger>10</Feral_Digger>
                    <Feral_Fledgling>5</Feral_Fledgling>
                    <Feral_Hunter>10</Feral_Hunter>
                    <Feral_Protector>5</Feral_Protector>
                    <Feral_Matriarch>1</Feral_Matriarch>
                    <Megaspider>0.75</Megaspider>
                </options>
            </li>
            <li>
                <!-- Peaceful -->
                <kindDef>Peaceful</kindDef>
                <options>
                    <!--<Feral_Kit>10</Feral_Kit>-->
                    <Feral_Fledgling>20</Feral_Fledgling>
                    <Feral_Hunter>15</Feral_Hunter>
                    <Feral_Protector>10</Feral_Protector>
                </options>
            </li>
            <li>
                <kindDef>Trader</kindDef>
                <traders>
                    <Tribal_Trader>1</Tribal_Trader>
                </traders>
                <guards>
                    <Feral_Fledgling>5</Feral_Fledgling>
                    <Feral_Hunter>20</Feral_Hunter>
                    <Feral_Protector>10</Feral_Protector>
                    <Megascarab>3</Megascarab>
                    <Spelopede>3</Spelopede>
                    <Megaspider>0.75</Megaspider>
                </guards>
                <carriers>
                    <Yak>5</Yak>
                    <Donkey>6</Donkey>
                    <Alpaca>2.5</Alpaca>
                </carriers>
            </li>
            <li>
                <kindDef>Settlement</kindDef>
                <options>
                    <Feral_Fledgling>10</Feral_Fledgling>
                    <Feral_Hunter>20</Feral_Hunter>
                    <Feral_Protector>10</Feral_Protector>
                    <Feral_Matriarch>3</Feral_Matriarch>
                    <Megascarab>3</Megascarab>
                    <Spelopede>2</Spelopede>
                    <Megaspider>0.75</Megaspider>
                </options>
            </li>
        </pawnGroupMakers>
        <modExtensions>
            <li Class="VEF.Factions.FactionDefExtension">
                <allowedBiomes>
                    <li>BorealForest</li>
                    <li>Tundra</li>
                    <li>ColdBog</li>
                    <li MayRequire="Ludeon.RimWorld.Odyssey">GlacialPlain</li>
                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_CrystalCaverns</li>
                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_EarthenDepths</li>
                    <li MayRequire="BiomesTeam.BiomesCaverns">BMT_FungalForest</li>
                </allowedBiomes>
                <startingGoodwillByFactionDefs>
                    <PlayerWarren>-80~-50</PlayerWarren>
                </startingGoodwillByFactionDefs>
            </li>
        </modExtensions>
    </FactionDef>

    <ThingSetMakerDef>
        <defName>WarrenRaidLootMaker</defName>
        <root Class="ThingSetMaker_MarketValue">
            <fixedParams>
                <filter>
                    <thingDefs>
                        <li>Silver</li>
                        <li>Jade</li>
                        <li>MedicineHerbal</li>
                        <li>InsectJelly</li>
                        <li>Meat_Human</li>
                    </thingDefs>
                </filter>
            </fixedParams>
        </root>
    </ThingSetMakerDef>


    <RulePackDef>
        <defName>NamerFactionFeralWarren</defName>

        <rulePack>
            <rulesStrings>
                <li>r_name(p=3)->[warren] of [adjective] [ofThing]</li>
                <li>r_name->The [warren] of [ofThing]</li>
                <li>r_name->The [warren]</li>
                <li>r_name->[mineral] [warren]</li>
                <li>r_name->[adjective] [mineral] [warren]</li>

                <li>warren(p=3)->Warren</li>
                <li>warren->Burrow</li>
                <li>warren->Tunnels</li>
                <li>warren->Caves</li>

                <li>adjective->Bloodied</li>
                <li>adjective->Torn</li>
                <li>adjective->Rotten</li>
                <li>adjective->Painful</li>
                <li>adjective->Splitting</li>
                <li>adjective->Broken</li>
                <li>adjective->Lightless</li>
                <li>adjective->Deadly</li>
                <li>adjective->Gnashing</li>
                <li>adjective->Festering</li>
                <li>adjective->Cruel</li>
                <li>adjective->Serrated</li>
                <li>adjective->Ruthless</li>
                <li>adjective->Barren</li>

                <li>ofThing->Blood</li>
                <li>ofThing->Dust</li>
                <li>ofThing->Plague</li>
                <li>ofThing->Slaughter</li>
                <li>ofThing->Flesh</li>
                <li>ofThing->Entrails</li>
                <li>ofThing->Blades</li>
                <li>ofThing->Claws</li>
                <li>ofThing->Agony</li>

                <li>mineral->stone</li>
                <li>mineral->slate</li>
                <li>mineral->salt</li>
                <li>mineral->basalt</li>
                <li>mineral->marble</li>
                <li>mineral->obsidian</li>
                <li>mineral->steel</li>
                <li>mineral->copper</li>
                <li>mineral->iron</li>
                <li>mineral->flint</li>
                <li>mineral->tin</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>


    <RulePackDef>
        <defName>NamerSettlementFeralWarren</defName>

        <rulePack>
            <rulesStrings>
                <li>r_name->[mineral] [location]</li>
                <li>r_name->[adjective] [location]</li>
                <li>r_name->[adjective] [mineral] [location]</li>

                <li>location->Caves</li>
                <li>location->Forest</li>
                <li>location->Sea</li>
                <li>location->Shores</li>
                <li>location->Tunnels</li>
                <li>location->Bog</li>
                <li>location->Swamp</li>
                <li>location->Plain</li>
                <li>location->Mountain</li>
                <li>location->Valley</li>
                <li>location->Island</li>
                <li>location->Canyon</li>
                <li>location->Hills</li>
                <li>location->Plateau</li>

                <li>adjective->Bloodied</li>
                <li>adjective->Torn</li>
                <li>adjective->Rotten</li>
                <li>adjective->Painful</li>
                <li>adjective->Splitting</li>
                <li>adjective->Broken</li>
                <li>adjective->Lightless</li>
                <li>adjective->Deadly</li>
                <li>adjective->Gnashing</li>
                <li>adjective->Festering</li>
                <li>adjective->Cruel</li>
                <li>adjective->Serrated</li>
                <li>adjective->Ruthless</li>
                <li>adjective->Barren</li>

                <li>ofThing->Blood</li>
                <li>ofThing->Dust</li>
                <li>ofThing->Plague</li>
                <li>ofThing->Slaughter</li>
                <li>ofThing->Flesh</li>
                <li>ofThing->Entrails</li>
                <li>ofThing->Blades</li>
                <li>ofThing->Claws</li>
                <li>ofThing->Agony</li>

                <li>mineral->stone</li>
                <li>mineral->slate</li>
                <li>mineral->salt</li>
                <li>mineral->basalt</li>
                <li>mineral->marble</li>
                <li>mineral->obsidian</li>
                <li>mineral->steel</li>
                <li>mineral->copper</li>
                <li>mineral->iron</li>
                <li>mineral->flint</li>
                <li>mineral->tin</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>