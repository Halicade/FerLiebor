<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="PlayerFactionBase">
  <defName>PlayerWarren</defName>
  <label>Warren</label>
  <description>A player-controlled group of cavelings.</description>
  <isPlayer>true</isPlayer>
  <categoryTag>Tribal</categoryTag>
  <pawnSingular>caveling</pawnSingular>
  <pawnsPlural>cavelings</pawnsPlural>
  <basicMemberKind>FL_Caveling</basicMemberKind>
  <techLevel>Animal</techLevel>
  <factionNameMaker>NamerFactionWarren</factionNameMaker>
  <settlementNameMaker>NamerSettlementWarren</settlementNameMaker>
  <allowedCultures>
    <li>Corunan</li>
  </allowedCultures>
  <startingResearchTags>
   <li>TribalStart</li>
  </startingResearchTags>
  <startingTechprintsResearchTags>
   <li>TribalStart</li>
   <li>TribalStartTechprints</li>
  </startingTechprintsResearchTags>
  <backstoryFilters>
    <li>
      <categories>
        <li>Tribal</li>
      </categories>
    </li>
  </backstoryFilters>
  <factionIconPath>UI/BunFactionIcon</factionIconPath>
  <settlementTexturePath>UI/BunSettlementIcon</settlementTexturePath>
  <forageabilityFactor>1.7</forageabilityFactor>
  <modExtensions>
			<li Class="VEF.Factions.FactionDefExtension">
			 <startingGoodwillByFactionDefs>
				 <OutlanderCivil>-55~-70</OutlanderCivil>
				 <Empire MayRequire="Ludeon.RimWorld.Royalty">-75~-100</Empire>
				 <OutlanderRefugee MayRequire="Ludeon.RimWorld.Royalty">-75~-100</OutlanderRefugee>
				 <TribeCivil>-55~-70</TribeCivil>
         <TradersGuild MayRequire="Ludeon.RimWorld.Odyssey">-55~-70</TradersGuild>
				 <Ancients>-100~-100</Ancients>
				 <Insect>30~10</Insect>
			 </startingGoodwillByFactionDefs>
			</li>
	</modExtensions>
  </FactionDef>

