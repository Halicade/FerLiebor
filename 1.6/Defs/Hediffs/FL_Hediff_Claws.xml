<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	<HediffDef ParentName="ImplantHediffBase">
		<defName>FL_Claws</defName>
		<label>claws</label>
		<labelNoun>claws</labelNoun>
		<description>A set of sharp claws.</description>
		<descriptionHyperlinks>
			<GeneDef>Fer_Liebor_NaturalWeapons</GeneDef>
		</descriptionHyperlinks>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<comps>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<li>
						<label>claws</label>
						<capacities>
							<li>Scratch</li>
						</capacities>
						<power>20</power>
						<armorPenetration>0.15</armorPenetration>
						<cooldownTime>1.5</cooldownTime>
					</li>
				</tools>
			</li>
		</comps>
		<addedPartProps>
			<betterThanNatural>true</betterThanNatural>
		</addedPartProps>
	</HediffDef>

	<RecipeDef ParentName="SurgeryRemoveImplantBase">
		<defName>FL_RemoveClaws</defName>
		<label>sand down claws</label>
		<description>Sanding claws down to stumps.</description>
		<descriptionHyperlinks>
			<HediffDef>FL_Claws</HediffDef>
		</descriptionHyperlinks>
		<jobString>Sanding down claws.</jobString>
		<isViolation>true</isViolation>
		<successfullyRemovedHediffMessage>{0} has successfully sanded down the claws of {1}.</successfullyRemovedHediffMessage>
		<removesHediff>FL_Claws</removesHediff>
		<surgeryIgnoreEnvironment>true</surgeryIgnoreEnvironment>
		<skillRequirements>
			<Medicine>2</Medicine>
		</skillRequirements>
	</RecipeDef>

</Defs>